# Copy to .env and adjust.
ETAL_BIN=/home/grim/Documents/projects/uxn-dsl/build/linux-x86/etal
ETAL_VERSION=0.1.3
DATABASE_URL=postgresql+psycopg://uxn:uxn@localhost:5432/uxnweb
COMPILE_TIMEOUT=60
# Empty = open dev mode. Production: comma-separated secrets.
API_KEYS=
# --- LLM provider keys (server-side only, never sent to browsers) ---
# Set the ones you hold; unset providers are automatically excluded
# from routing. Names, never values, appear in /agent/providers.
# With only one of these set, the agent runs on that provider — and
# when it has a free tier (OpenRouter's `:free` ids, Groq, Cerebras)
# that free model is what gets picked.
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# The browser calls POST /agent/turn and names no provider: routing,
# keys, budgets and the breaker all live here. Per-caller turn cap
# (users by id, guests by IP) and whether guests may use the agent.
AGENT_TURNS_PER_MINUTE=20
AGENT_ALLOW_GUESTS=1
# Seconds to wait on a provider before the turn fails and the breaker
# trips. Raise it for slow self-hosted models, lower it for fast APIs.
LLM_TIMEOUT=120
# Escape hatch: register any OpenAI-compatible endpoint as a local
# candidate (local model server, self-hosted gateway, mock). Free tier
# and `local`, so it answers before any hosted model when set. Unset =
# absent. Read live, like the keys: no restart needed.
# LLM_DEV_BASE_URL=http://127.0.0.1:11500/v1
# LLM_DEV_MODEL=local
# LLM_DEV_KEY_ENV=MY_GATEWAY_API_KEY   # only if the endpoint needs one
# Local Ollama (http://localhost:11434) is registered but off by
# default. Name a model, then enable the row:
#   POST /admin/llm/provider {"provider":"ollama","enabled":true}
# It is free tier and `local`, so it answers before any hosted model.
# OLLAMA_MODEL=llama3.1:latest
# local = dev checkout at ETAL_BIN; release:<tag> = pinned GitHub
# release, hash-verified (see scripts/fetch-compiler.sh).
ETAL_SOURCE=local
COMPILER_DIR=/opt/etal
# Production: random value (all tokens forgeable otherwise).
JWT_SECRET=dev-only-secret-change-me
ACCESS_MINUTES=30
REFRESH_DAYS=30
AUTH_RATE_PER_MINUTE=10
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_COMPILES=4
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:4321
# Level for our own loggers (uxn.*, uxnweb.*) — the routing decision,
# provider failures, breaker trips. WARNING drops the per-turn lines.
LOG_LEVEL=INFO
